# Copia a .env.aula (no se sube a git) y ejecuta: ./scripts/deploy-aula.sh

# Cuenta de la clase: entra y solo escucha.
AULA_CLASS_USER=aulacuatro
AULA_CLASS_PASSWORD=cambia-esta-contraseña

# Cuenta admin (usuario: admin). Puede añadir canciones.
AULA_ADMIN_PASSWORD=cambia-esta-otra

# Carpeta de canciones del aula, distinta de ./music del catálogo.
# AULA_MUSIC_HOST_PATH=/ruta/en/el/hp/music-aula

# Título visible. Si tiene espacios, va entre comillas. Por defecto: Aula 4
# AULA_SITE_TITLE="Aula 4"

# Ruta al proyecto quitar-voz en el host. Por defecto: ../quitarvoces
# QUITAR_VOZ_HOST_PATH=../quitarvoces
