# Alternativa al token: túnel creado con `cloudflared tunnel create`.
# Copia a cloudflared/config.yml y sustituye UUID y hostname.
# Credenciales en cloudflared/<UUID>.json (generado por cloudflared).

tunnel: REEMPLAZA-CON-UUID-DEL-TUNEL
credentials-file: /etc/cloudflared/REEMPLAZA-CON-UUID-DEL-TUNEL.json

ingress:
  - hostname: musica.tudominio.com
    service: http://localhost:5001
  - service: http_status:404
